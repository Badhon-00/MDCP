{
  "name": "mdcp-youtube-studio",
  "version": "1.1.0",
  "description": "One compact, cross-agent YouTube creator plugin and MCP tool for cloud and local runtimes.",
  "runtime": {"language":"node","version":">=20","module":"esm","entrypoint":"runtime/index.js"},
  "entrypoints": {
    "agent_tool":"runtime/agent-tool.js",
    "canonical_skill":"../../skills/youtube-studio/SKILL.md",
    "mcp_registration":"registerYouTubeTool"
  },
  "compatibility": ["MCP-compatible-hosts","Claude-Code","Codex","ChatGPT-Projects-and-connectors","Cursor","Google-Antigravity","Gemini-based-agents","Windsurf","generic-agent-runtimes"],
  "capabilities": ["youtube.search","youtube.channel.read","youtube.video.read","youtube.analytics.read","youtube.video.upload","youtube.playlist.write","youtube.thumbnail.generate","youtube.media.download_owned","youtube.seo.plan","youtube.channel.monitor"],
  "auth": {
    "secrets":["YOUTUBE_API_KEY","YOUTUBE_CLIENT_ID","YOUTUBE_CLIENT_SECRET","YOUTUBE_REFRESH_TOKEN"],
    "scopes":["https://www.googleapis.com/auth/youtube.upload","https://www.googleapis.com/auth/youtube.readonly","https://www.googleapis.com/auth/yt-analytics.readonly"],
    "secret_storage":"host-secret-manager"
  },
  "approval_required":["upload","public_publish","visibility_change","delete","playlist_add","comment_write"],
  "quota":{"provider":"youtube-data-api-v3","cloud":"shared-durable-ledger-required","local":"in-memory-fallback-development-only"},
  "tools":[{
    "name":"youtube",
    "entrypoint":"runtime/agent-tool.js",
    "description":"Single operation-routed tool; detailed workflows remain in the skill and are loaded only when needed.",
    "operations":["search","video_stats","channel_overview","analytics","upload","playlist_add","thumbnail","download_owned"]
  }]
}
